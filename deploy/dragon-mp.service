[Unit]
Description=Dragon Craft multiplayer server
After=network.target

[Service]
User=devuser
WorkingDirectory=/home/devuser/projects/dragon-craft/server
Environment=DATA_DIR=/var/lib/dragon-craft
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dragon-craft
PrivateTmp=true

[Install]
WantedBy=multi-user.target
